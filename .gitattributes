# Binary 3D / texture / scientific-viz assets live in Git LFS.
# (Text formats — obj, mtl, gltf, usda, stp/step, igs, dae, off, txt — stay in git.)
*.glb     filter=lfs diff=lfs merge=lfs -text
*.stl     filter=lfs diff=lfs merge=lfs -text
*.ply     filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.abc     filter=lfs diff=lfs merge=lfs -text
*.drc     filter=lfs diff=lfs merge=lfs -text
*.usd     filter=lfs diff=lfs merge=lfs -text
*.usdz    filter=lfs diff=lfs merge=lfs -text
*.vdb     filter=lfs diff=lfs merge=lfs -text
*.spz     filter=lfs diff=lfs merge=lfs -text
*.splat   filter=lfs diff=lfs merge=lfs -text
*.mdl     filter=lfs diff=lfs merge=lfs -text
*.xbf     filter=lfs diff=lfs merge=lfs -text
*.ex2     filter=lfs diff=lfs merge=lfs -text
*.e       filter=lfs diff=lfs merge=lfs -text
*.3ds     filter=lfs diff=lfs merge=lfs -text
# VTK family (mostly binary containers)
*.vtp     filter=lfs diff=lfs merge=lfs -text
*.vtu     filter=lfs diff=lfs merge=lfs -text
*.vti     filter=lfs diff=lfs merge=lfs -text
*.vtm     filter=lfs diff=lfs merge=lfs -text
*.vtt     filter=lfs diff=lfs merge=lfs -text
*.vtkhdf  filter=lfs diff=lfs merge=lfs -text
# glTF external buffers + textures
