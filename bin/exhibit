#!/usr/bin/env ruby
# frozen_string_literal: true

# Exhibit-rb entry point. HANDLES_OPEN means paths on argv arrive via the
# application's 'open' signal (one window each); a bare launch shows startup.

require_relative '../lib/application'

# tap(&:build) wires the app signals and returns the Exhibit::Application (build
# itself returns the inner Gtk::Application), so .run is *our* run — the one that
# prepends the program name so file args reach the 'open' handler.
Exhibit::Application.new.tap(&:build).run(ARGV)
